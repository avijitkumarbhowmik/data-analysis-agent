# ── Database ──────────────────────────────────────────────────────────
# SQLite for this private single-user local tool. Schema is kept portable
# for a clean future Postgres migration.
AGENT_DATABASE_URL=sqlite:///./data/agent.db

# ── LLM provider (Gemini) ─────────────────────────────────────────────
# This agent uses Google Gemini. Set your key below.
AGENT_GEMINI_API_KEY=

# Model is PINNED. Use gemini-2.5-flash. Do NOT use gemini-3.1-pro
# (an invalid id that must never be relied on as a default).
AGENT_LLM_MODEL=gemini-2.5-flash

# Optional: force the provider explicitly (auto-detected from the key above).
# AGENT_LLM_PROVIDER=gemini

# ── Server ────────────────────────────────────────────────────────────
PORT=8001
